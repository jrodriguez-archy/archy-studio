{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["iad1"],
  "functions": {
    "app/api/render/route.ts": {
      "memory": 2048,
      "maxDuration": 60
    },
    "app/mcp/route.ts": {
      "memory": 2048,
      "maxDuration": 60
    },
    "app/api/preview-render/[template]/[format]/route.ts": {
      "memory": 2048,
      "maxDuration": 60
    },
    "app/api/canvas/route.ts": {
      "memory": 2048,
      "maxDuration": 60
    }
  }
}
