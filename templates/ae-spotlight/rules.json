{
  "_comment": "Authored by design (not generated). Layer names are matched by prefix. 'within' is the box a slot's block must stay inside, keeping the same margin it has in the design (mirror). Values can be per format. 'scaleGroup': every text in that layer scales together with the slot (headline reads as one unit). 'inset' sets the margin explicitly. 'variants.<name>.slots' overrides slot rules for that variant.",
  "slots": {
    "ae-first-name": {
      "within": "Content",
      "maxLines": 1,
      "minScale": 0.7,
      "scaleGroup": "Hero"
    },
    "ae-name": {
      "block": "optional-ae-plate",
      "within": "Photo Panel",
      "maxLines": 2,
      "minScale": 0.85
    },
    "ae-title": {
      "block": "optional-ae-plate",
      "within": "Photo Panel",
      "maxLines": 2,
      "minScale": 0.85
    },
    "ae-location": {
      "block": "optional-ae-location",
      "within": {
        "post": "Photo Panel",
        "stories": "@artboard"
      },
      "maxLines": 1,
      "minScale": 0.85,
      "checkBottom": false,
      "avoid": {
        "stories": [
          {
            "node": "Archy Wordmark",
            "gap": 32
          }
        ]
      }
    }
  },
  "containers": [
    {
      "node": "Content",
      "avoid": {
        "stories": [
          {
            "node": "Photo Panel",
            "gap": 0
          }
        ]
      }
    }
  ],
  "variants": {
    "no-photo": {
      "slots": {
        "ae-name": {
          "inset": 40,
          "checkBottom": false
        },
        "ae-title": {
          "inset": 40,
          "checkBottom": false
        }
      }
    }
  }
}